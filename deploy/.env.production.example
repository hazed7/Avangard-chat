# Managed by deploy/server-deploy.sh during rollout.
# Keep real secrets on the server or in GitHub Actions production secrets.

APP_DOMAIN=api.example.com
DOCKER_IMAGE=ghcr.io/hazed7/avangard-chat/app:latest
LIVEKIT_URL=wss://api.example.com:7880

JWT_SECRET_KEY=replace-me
REFRESH_TOKEN_SECRET_KEY=replace-me
MESSAGE_CURSOR_SECRET_KEY=replace-me
MESSAGE_ENCRYPTION_ACTIVE_KEY_ID=v1
MESSAGE_ENCRYPTION_KEYS={"v1":"replace-me"}
TYPESENSE_API_KEY=replace-me
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
AI_API_KEY=replace-me

AI_BASE_URL=https://api.groq.com/openai/v1
AI_SUMMARY_MODEL=llama-3.3-70b-versatile
AI_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

MONGODB_IMAGE=mongo:4.4.29
DRAGONFLY_IMAGE=docker.dragonflydb.io/dragonflydb/dragonfly:v1.27.1
LIVEKIT_IMAGE=livekit/livekit-server:v1.11.0
TYPESENSE_IMAGE=typesense/typesense:27.1
S3_IMAGE=rustfs/rustfs:latest
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest
CADDY_IMAGE=caddy:2.8
